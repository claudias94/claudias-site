# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-value

# "development" (default) or "production". In production, session cookies
# require HTTPS — see DEPLOYMENT.md before setting this.
FLASK_ENV=development

# Number of reverse proxies in front of this app (nginx, a platform's edge,
# a load balancer, ...). 0 = none (default; correct for local development
# and for hosts that route traffic straight to the app). Set to 1 once
# deployed behind a single proxy so rate limiting and the audit log see the
# real visitor IP instead of the proxy's address.
TRUST_PROXY=0

# Port to listen on when run via Gunicorn (see DEPLOYMENT.md). Many hosting
# platforms set this automatically.
PORT=8000
